---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import Socials from "@/components/Socials.astro";
import WelcomeCard from "@/components/WelcomeCard.astro";
import IconBook from "@/assets/icons/IconBook.svg";
import IconArticle from "@/assets/icons/IconArticle.svg";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";
import { getLocaleFromPath, getLocalizedPath, useTranslations } from "@/i18n";
import {
  getContentRelativePath,
  resolveLocalizedEntries,
} from "@/utils/localizedContent";
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = resolveLocalizedEntries(allPosts, "blog", locale);

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const allBooks = await getCollection("books", ({ data }) => !data.draft);
// 书籍章节可能位于 locale 目录下（如 en/getting-started/...），
// id 首段会是 locale 而非书名——先剥离 locale 段再取首段
const bookCount = new Set(
  allBooks.map(book => getContentRelativePath(book, "books").split("/")[0])
).size;
const tagCount = new Set(sortedPosts.flatMap(({ data }) => data.tags ?? []))
  .size;
---

<Layout localeAlternates>
  <Header />
  <main id="main-content" data-layout="index" class="browse-layout">
    <section id="hero" class:list={["pt-8 pb-8", "border-b border-border"]}>
      <div
        class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-stretch"
      >
        {/* 左：身份 + 社交 + 统计/入口，与右卡等高时底部对齐 */}
        <div class="flex min-w-0 flex-col gap-6">
          <div class="flex items-center gap-5 sm:gap-6">
            {
              config.site.avatar && (
                <img
                  src={config.site.avatar}
                  alt={config.site.author}
                  width="112"
                  height="112"
                  class="size-24 flex-none rounded-[var(--surface-radius)] border border-border object-cover sm:size-28"
                  loading="eager"
                />
              )
            }
            <div class="min-w-0">
              <h1
                class="flex flex-wrap items-center gap-x-2.5 text-2xl font-bold sm:text-3xl"
              >
                {config.site.author}
                <a
                  target="_blank"
                  href={getLocalizedPath("/rss.xml", locale)}
                  class="inline-block"
                  aria-label="rss feed"
                  title="RSS Feed"
                >
                  <IconRss
                    width={18}
                    height={18}
                    class="scale-110 stroke-accent stroke-3 rtl:-rotate-90"
                  />
                  <span class="sr-only">RSS Feed</span>
                </a>
              </h1>
              <p class="mt-1.5 font-reading leading-7 text-muted-foreground">
                {config.site.description}
              </p>
            </div>
          </div>

          {
            config.socials.length > 0 && (
              <div class="flex items-center">
                <span class="me-2 text-sm whitespace-nowrap text-muted-foreground">
                  {t.home.socialLinks}
                </span>
                <Socials />
              </div>
            )
          }

          <div
            class="mt-auto flex flex-wrap items-end justify-between gap-x-8 gap-y-4"
          >
            <div class="flex gap-x-8 sm:gap-x-10">
              {
                [
                  {
                    n: sortedPosts.length,
                    label: t.home.statsPosts,
                    href: getLocalizedPath("/posts/", locale),
                  },
                  {
                    n: bookCount,
                    label: t.home.statsBooks,
                    href: getLocalizedPath("/books/", locale),
                  },
                  {
                    n: tagCount,
                    label: t.home.statsTags,
                    href: getLocalizedPath("/tags/", locale),
                  },
                ].map(({ n, label, href }) => (
                  <a
                    href={href}
                    class="focus-outline rounded-xs leading-none hover:text-accent"
                  >
                    <div class="text-2xl font-bold tabular-nums">{n}</div>
                    <div class="mt-1.5 text-xs text-muted-foreground">
                      {label}
                    </div>
                  </a>
                ))
              }
            </div>
            <div class="flex items-center gap-2">
              <LinkButton
                href={getLocalizedPath("/books/", locale)}
                class="rounded-md border border-border px-3 py-1.5 text-sm hover:border-accent hover:text-accent"
              >
                <IconBook class="size-4" />
                {t.home.browseBooks}
              </LinkButton>
              <LinkButton
                href={getLocalizedPath("/posts/", locale)}
                class="rounded-md border border-border px-3 py-1.5 text-sm hover:border-accent hover:text-accent"
              >
                <IconArticle class="size-4" />
                {t.home.allPosts}
              </LinkButton>
            </div>
          </div>
        </div>

        {/* 右：问候 + 天气（单卡，来源置底） */}
        <WelcomeCard />
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" requestedLocale={locale} {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < config.posts.perIndex && (
                  <Card variant="h3" requestedLocale={locale} {...data} />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getLocalizedPath("/posts/", locale)}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <BackToTopButton />
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", window.location.pathname);
    }
  });
</script>

---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import config from "@/config";
import {
  getLocaleFromPath,
  getLocalizedPath,
  tplStr,
  useTranslations,
} from "@/i18n";
import { resolveLocalizedEntries } from "@/utils/localizedContent";
import { toTransitionName } from "@/utils/toTransitionName";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const posts = resolveLocalizedEntries(allPosts, "blog", config.site.lang);
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const alternateLocale = config.i18n.locales.find(l => l !== locale);
const tagPath =
  page.currentPage > 1 ? `/tags/${tag}/${page.currentPage}` : `/tags/${tag}`;
const alternateUrl = alternateLocale
  ? getLocalizedPath(tagPath, alternateLocale)
  : undefined;

// 标题形如「标签：astro」。连接符随语言走（中文全角冒号，英文冒号加空格），
// Main 的数组标题在两段之间不留空白
const heading = `${t.pages.tagTitle}${t.pages.tagTitleSep}`;

// 描述里的文章数是该标签下的总数（不分页）；只有 1 篇时用单数文案（有的语言要区分）
const pageDesc = tplStr(
  page.total === 1 && t.pages.tagDescOne ? t.pages.tagDescOne : t.pages.tagDesc,
  { count: page.total }
);
---

<Layout title={`${heading}${tagName} | ${config.site.title}`} localeAlternates>
  <Header {alternateUrl} />
  <Main
    pageTitle={[heading, tagName]}
    titleTransition={toTransitionName(String(tag), "tag")}
    pageDesc={pageDesc}
    width="browse"
  >
    <ul>
      {page.data.map(data => (
        <Card requestedLocale={locale} {...data} />
      ))}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

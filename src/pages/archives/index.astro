---
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import type { CollectionEntry } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import { resolveTimezone } from "@/utils/resolveTimezone";
import config from "@/config";
import { getLocaleFromPath, useTranslations } from "@/i18n";
import { resolveLocalizedEntries } from "@/utils/localizedContent";

dayjs.extend(utc);
dayjs.extend(timezone);

if (!config.features.showArchives) {
  return Astro.redirect("/404");
}

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = resolveLocalizedEntries(allPosts, "blog", locale);

const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });

// 按文章署名日期（站点/文章时区）的日历日分组，而非构建机的本地时区（上游 v7.0）
const publishDate = (post: CollectionEntry<"blog">) =>
  dayjs(post.data.pubDatetime).tz(
    resolveTimezone(post.data.timezone ?? config.site.timezone)
  );
---

<Layout
  title={`${t.pages.archivesTitle} | ${config.site.title}`}
  localeAlternates
>
  <Header />
  <Main
    pageTitle={t.pages.archivesTitle}
    pageDesc={t.pages.archivesDesc}
    width="browse"
  >
    {
      Object.entries(
        getPostsByGroupCondition(posts, post => publishDate(post).year())
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div>
            <span class="text-2xl font-bold">{year}</span>
            <span class="ms-2 inline-flex items-center rounded-full bg-muted/60 px-2 py-0.5 text-xs font-medium text-muted-foreground tabular-nums">
              {yearGroup.length}
            </span>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => publishDate(post).month() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="flex flex-col sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg sm:my-6">
                    <span class="font-bold">
                      {monthFormatter.format(new Date(2024, Number(month) - 1))}
                    </span>
                    <span class="ms-2 inline-flex items-center rounded-full bg-muted/60 px-1.5 py-0.5 text-xs font-medium text-muted-foreground tabular-nums">
                      {monthGroup.length}
                    </span>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.pubDatetime).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.pubDatetime).getTime() / 1000
                          )
                      )
                      .map(data => (
                        <Card requestedLocale={locale} {...data} />
                      ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>
  <Footer />
</Layout>

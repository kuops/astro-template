---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BookSidebar from "@/components/BookSidebar.astro";
import BookMobileNav from "@/components/BookMobileNav.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import MobileToc from "@/components/MobileToc.astro";
import ArticleEnhancements from "@/components/ArticleEnhancements.astro";
import MermaidRenderer from "@/components/MermaidRenderer.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import ReadingMetadata from "@/components/ReadingMetadata.astro";
import config from "@/config";
import { getLocaleFromPath } from "@/i18n";
import type { SidebarGroup } from "@/types/books";
import type { Locale } from "@/types/config";

type Props = {
  title: string;
  description: string;
  bookTitle: string;
  bookSlug: string;
  sidebar: SidebarGroup[];
  currentSlug: string;
  titleMap?: Record<string, string>;
  hrefMap: Record<string, string>;
  sourceLocaleMap?: Record<string, Locale>;
  headings: { depth: number; slug: string; text: string }[];
  readingLabel?: string;
  sourceLabel?: string;
  indexable?: boolean;
  alternateUrl?: string;
  /** 渲染好的反向语言提示文案（如「阅读 English 版」），上游判定后传入 */
  translationHint?: string;
  canonicalURL?: string;
};

const {
  title,
  description,
  bookTitle,
  bookSlug,
  sidebar,
  currentSlug,
  titleMap = {},
  hrefMap,
  sourceLocaleMap,
  headings,
  readingLabel,
  sourceLabel,
  indexable = true,
  alternateUrl,
  translationHint,
  canonicalURL,
} = Astro.props;

const routeLocale = getLocaleFromPath(Astro.url.pathname);
---

<Layout
  title={`${title} | ${config.site.title}`}
  description={description}
  contentLang={sourceLocaleMap?.[currentSlug]}
  {canonicalURL}
>
  <Header {alternateUrl} />
  <BookMobileNav
    {bookTitle}
    {bookSlug}
    {sidebar}
    {currentSlug}
    {titleMap}
    {hrefMap}
    {sourceLocaleMap}
    {headings}
  />
  <main
    id="main-content"
    class="mx-auto w-full max-w-chrome px-4 py-12"
    data-pagefind-body={indexable ? "" : undefined}
    data-pagefind-ignore={indexable ? undefined : "all"}
    data-pagefind-filter="type:book"
    data-pagefind-meta={`contentLang:${sourceLocaleMap?.[currentSlug] ?? routeLocale}`}
  >
    <div class="flex gap-8">
      <aside class="hidden w-64 flex-none lg:block">
        <div class="sidebar-scroll sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto overscroll-contain">
          <BookSidebar
            {bookSlug}
            {sidebar}
            {currentSlug}
            {titleMap}
            {hrefMap}
            {sourceLocaleMap}
          />
        </div>
      </aside>
      <div class="min-w-0 flex-1">
        {translationHint && alternateUrl && (
          <p class="mb-3 text-sm text-muted-foreground">
            <a
              href={alternateUrl}
              class="underline decoration-dashed underline-offset-4 hover:text-accent"
            >
              {translationHint}
            </a>
          </p>
        )}
        <h1
          class="mb-8 text-[1.75rem] leading-9 font-bold text-accent sm:text-3xl"
          data-pagefind-meta="title"
        >
          {title}
        </h1>
        {(sourceLabel || readingLabel) && (
          <div class="mb-8 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
            {sourceLabel && <span>{sourceLabel}</span>}
            {sourceLabel && readingLabel && (
              <span aria-hidden="true" class="text-foreground/40">
                ·
              </span>
            )}
            {readingLabel && <ReadingMetadata label={readingLabel} />}
          </div>
        )}
        <article
          id="article"
          class="app-prose w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
        >
          <slot />
        </article>
      </div>
      {headings.length > 0 && (
        <aside class="hidden w-64 flex-none xl:block">
          <div
            data-toc-scroll
            class="toc-scroll sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto overscroll-contain"
          >
            <TableOfContents {headings} />
          </div>
        </aside>
      )}
    </div>
  </main>
  {/* 浮动按钮放在 main 外：进场动画期间 main 带 transform，固定定位的后代会错位 */}
  <BackToTopButton />
  {headings.length > 0 && <MobileToc headings={headings} />}
  <Footer />
</Layout>

<ArticleEnhancements />

<MermaidRenderer />

<ImageLightbox />

<style>
  @media (max-width: 63.999rem) {
    :global(#article h2),
    :global(#article h3),
    :global(#article h4) {
      scroll-margin-top: 4rem;
    }
  }
</style>

---
import { getLocaleFromPath, useTranslations } from "@/i18n";

const t = useTranslations(getLocaleFromPath(Astro.url.pathname));
---

<span
  id="i18n-mermaid-preview"
  class="hidden"
  data-label={t.mermaid.preview}
></span>
<span
  id="i18n-mermaid-source"
  class="hidden"
  data-label={t.mermaid.source}
></span>
<span
  id="i18n-mermaid-copy"
  class="hidden"
  data-label={t.mermaid.copySource}
></span>
<span id="i18n-mermaid-copied" class="hidden" data-label={t.post.copied}></span>
<span
  id="i18n-mermaid-fullscreen"
  class="hidden"
  data-label={t.mermaid.fullscreen}
></span>
<span
  id="i18n-mermaid-close"
  class="hidden"
  data-label={t.mermaid.close}
></span>

<noscript>
  <style>
    .mermaid-block {
      min-height: 0;
    }
    .mermaid-block[data-mermaid-key] {
      min-height: 0;
    }
    .mermaid-block .mermaid-skeleton {
      display: none;
    }
    .mermaid-block[aria-busy] pre {
      display: block !important;
    }
  </style>
</noscript>

<script is:inline data-astro-rerun>
  window.__injectMermaidHeights?.();
  clearTimeout(Number(document.documentElement.dataset.mermaidWatchdog));
  document.documentElement.dataset.mermaidWatchdog = String(
    setTimeout(() => {
      document
        .querySelectorAll('.mermaid-block[aria-busy="true"]')
        .forEach(block => {
          block.setAttribute("aria-busy", "false");
          block.setAttribute("data-state", "error");
          const pre = block.querySelector("pre");
          if (pre) pre.style.display = "";
          block.style.minHeight = "0px";
        });
      document.dispatchEvent(new Event("article:layout-stable"));
    }, 10000)
  );
</script>

<style is:global>
  .mermaid-wrapper {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
    margin: 1.5rem 0;
  }

  .mermaid-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    background: var(--muted);
  }

  :root:not([data-theme="dark"]) .mermaid-header {
    background: var(--muted);
  }

  .mermaid-tab-group {
    display: flex;
    gap: 1px;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--foreground) 8%, transparent);
    padding: 2px;
  }

  .mermaid-tab {
    padding: 2px 12px;
    border-radius: 0.25rem;
    border: none;
    background: transparent;
    color: color-mix(in srgb, var(--foreground) 60%, transparent);
    font-size: 0.8125rem;
    cursor: pointer;
    line-height: 1.5;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .mermaid-tab.active {
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }

  .mermaid-tab:hover:not(.active) {
    color: var(--foreground);
  }

  .mermaid-actions {
    display: flex;
    gap: 0.25rem;
  }

  .mermaid-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.25rem;
    border: none;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
    opacity: 0.6;
    transition:
      opacity 0.15s,
      background 0.15s;
  }

  .mermaid-action-btn:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--foreground) 8%, transparent);
  }

  .mermaid-body {
    background: var(--background);
  }

  .mermaid-preview {
    padding: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .mermaid-preview svg {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .mermaid-source {
    display: none;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre;
    color: var(--foreground);
    margin: 0;
  }

  .mermaid-wrapper[data-mode="source"] .mermaid-preview {
    display: none;
  }

  .mermaid-wrapper[data-mode="source"] .mermaid-source {
    display: block;
  }

  .mermaid-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--background);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .mermaid-fullscreen .mermaid-fs-canvas {
    flex: 1;
    overflow: hidden;
    cursor: grab;
    width: 100%;
    position: relative;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--background);
  }

  .mermaid-fullscreen .mermaid-fs-canvas:active {
    cursor: grabbing;
  }

  .mermaid-fullscreen .mermaid-fs-canvas svg {
    max-width: none;
    position: absolute;
    top: 0;
    left: 0;
  }

  .mermaid-fs-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    flex-shrink: 0;
  }

  .mermaid-fs-toolbar button {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--muted);
    color: var(--foreground);
    font-size: 0.875rem;
    cursor: pointer;
    line-height: 1;
  }

  .mermaid-fs-toolbar button:hover {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .mermaid-fs-toolbar .zoom-label {
    font-size: 0.75rem;
    opacity: 0.7;
    min-width: 3rem;
    text-align: center;
    color: var(--foreground);
  }

  /* 配了全站背景图时（<html> 带 has-site-background，见 Layout.astro），面板改成
     半透明 + 毛玻璃：底色加在整个面板上，并把背后的背景模糊掉，头部和主体只保留
     各自的色调。图里的细线、虚线需要均匀的底才看得清，所以不做成全透明。
     不支持背景模糊的浏览器保持原样。全屏查看用的 .mermaid-fullscreen 始终不透明。
     模糊只写标准写法，不加 -webkit- 前缀：两者一起写会被构建工具合并成只剩前缀的那条，
     而新版 Chrome 已经不认前缀写法，模糊会整个失效 */
  @supports (backdrop-filter: blur(1px)) {
    html.has-site-background .mermaid-wrapper {
      background: color-mix(in srgb, var(--background) 72%, transparent);
      backdrop-filter: blur(14px);
    }
    html.has-site-background .mermaid-wrapper .mermaid-header {
      background: color-mix(in srgb, var(--muted) 80%, transparent);
    }
    html.has-site-background .mermaid-wrapper .mermaid-body {
      background: transparent;
    }
  }
</style>

<script>
  // 按需加载：仅当页面存在 mermaid 块时才动态 import mermaid（含 katex/
  // cytoscape 等重型 chunk），无图文章页不再无条件下载数百 KB。
  let mermaid: typeof import("mermaid").default | null = null;
  async function loadMermaid() {
    if (!mermaid) mermaid = (await import("mermaid")).default;
    return mermaid;
  }

  function getI18n(id: string) {
    return document.getElementById(id)?.dataset.label ?? "";
  }

  const HEIGHT_KEY_PREFIX = "mermaid-h:";

  function heightKey(key: string) {
    return (
      HEIGHT_KEY_PREFIX + location.pathname.replace(/\/+$/, "") + ":" + key
    );
  }

  function writeCachedHeight(key: string, height: number, width: number) {
    try {
      sessionStorage.setItem(
        heightKey(key),
        JSON.stringify({ w: width, h: height })
      );
    } catch {}
  }

  const mermaidSources: { el: HTMLElement; source: string }[] = [];

  function stripTheme(source: string) {
    return source.replace(/^---\n[\s\S]*?^---\n/m, frontmatter => {
      const cleaned = frontmatter.replace(/  theme:.*\n?/g, "");
      const inner = cleaned
        .replace(/^---\n?/, "")
        .replace(/\n?---\n?$/, "")
        .trim();
      if (!inner) return "";
      return `---\n${inner}\n---\n`;
    });
  }

  function initMermaidConfig(m: NonNullable<typeof mermaid>) {
    const isDark =
      document.documentElement.getAttribute("data-theme") === "dark";
    m.initialize({
      startOnLoad: false,
      theme: isDark ? "dark" : "default",
      themeVariables: isDark
        ? {
            primaryColor: "#c678dd",
            primaryTextColor: "#eaedf3",
            primaryBorderColor: "#3e4451",
            lineColor: "#abb2bf",
            secondaryColor: "#353c4d",
            tertiaryColor: "#2c313a",
            noteBkgColor: "#353c4d",
            noteTextColor: "#eaedf3",
            actorTextColor: "#eaedf3",
            actorBkgColor: "#353c4d",
            actorBorder: "#3e4451",
            labelTextColor: "#eaedf3",
            loopTextColor: "#eaedf3",
            sectionBkgColor: "#353c4d",
            altSectionBkgColor: "#2c313a",
            taskTextColor: "#eaedf3",
            taskBkgColor: "#c678dd",
            gridColor: "#3e4451",
            todayLineColor: "#e5c07b",
          }
        : {},
    });
  }

  // 操作按钮的图标：和代码块的复制按钮（ArticleEnhancements.astro）是同一套线条图标，
  // 这里显示为 16px。复制成功的反馈也和代码块一致：换成对勾、提示改成「已复制」、1.2 秒后恢复
  const expandSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" stroke-width="1.8"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" x2="14" y1="3" y2="10"/><line x1="3" x2="10" y1="21" y2="14"/></svg>`;

  const copySvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" stroke-width="1.8"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>`;
  const checkSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>`;

  function createFullscreen(svgHtml: string) {
    const overlay = document.createElement("div");
    overlay.className = "mermaid-fullscreen";

    const toolbar = document.createElement("div");
    toolbar.className = "mermaid-fs-toolbar";

    const canvas = document.createElement("div");
    canvas.className = "mermaid-fs-canvas";
    canvas.innerHTML = svgHtml;

    const svgEl = canvas.querySelector("svg");
    if (!svgEl) return;

    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    function applyTransform() {
      if (svgEl)
        svgEl.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
    }

    function resetView() {
      scale = 1;
      translateX = 0;
      translateY = 0;
      if (svgEl) svgEl.style.transform = "";
      updateLabel();
    }

    function fitView() {
      const vb = svgEl?.viewBox?.baseVal;
      if (!vb || vb.width === 0) return;
      const cw = canvas.clientWidth;
      const ch = canvas.clientHeight;
      const padding = 40;
      scale = Math.min((cw - padding) / vb.width, (ch - padding) / vb.height);
      translateX = (cw - vb.width * scale) / 2;
      translateY = (ch - vb.height * scale) / 2;
      applyTransform();
      updateLabel();
    }

    const label = document.createElement("span");
    label.className = "zoom-label";
    function updateLabel() {
      label.textContent = `${Math.round(scale * 100)}%`;
    }

    const zoomOut = document.createElement("button");
    zoomOut.textContent = "\u2212";
    zoomOut.addEventListener("click", () => {
      scale = Math.max(0.1, scale / 1.3);
      applyTransform();
      updateLabel();
    });

    const zoomIn = document.createElement("button");
    zoomIn.textContent = "+";
    zoomIn.addEventListener("click", () => {
      scale = Math.min(10, scale * 1.3);
      applyTransform();
      updateLabel();
    });

    const fitBtn = document.createElement("button");
    fitBtn.textContent = "Fit";
    fitBtn.addEventListener("click", fitView);

    const resetBtn = document.createElement("button");
    resetBtn.textContent = "1:1";
    resetBtn.addEventListener("click", resetView);

    const closeBtn = document.createElement("button");
    closeBtn.textContent = `\u2715 ${getI18n("i18n-mermaid-close")}`;
    closeBtn.addEventListener("click", () => {
      document.body.style.overflow = "";
      overlay.remove();
      document.removeEventListener("keydown", onKey);
    });

    function onKey(e: KeyboardEvent) {
      if (e.key === "Escape") closeBtn.click();
    }

    toolbar.append(zoomOut, label, zoomIn, fitBtn, resetBtn, closeBtn);
    overlay.append(toolbar, canvas);
    document.body.appendChild(overlay);
    document.body.style.overflow = "hidden";
    document.addEventListener("keydown", onKey);

    canvas.addEventListener(
      "wheel",
      e => {
        e.preventDefault();
        const rect = canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        const prev = scale;
        const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
        scale = Math.min(10, Math.max(0.1, scale * factor));
        translateX = mx - (mx - translateX) * (scale / prev);
        translateY = my - (my - translateY) * (scale / prev);
        applyTransform();
        updateLabel();
      },
      { passive: false }
    );

    canvas.addEventListener("mousedown", e => {
      if (e.button !== 0) return;
      isDragging = true;
      startX = e.clientX - translateX;
      startY = e.clientY - translateY;
    });

    window.addEventListener("mousemove", e => {
      if (!isDragging) return;
      translateX = e.clientX - startX;
      translateY = e.clientY - startY;
      applyTransform();
    });

    window.addEventListener("mouseup", () => {
      isDragging = false;
    });

    let pinchStartDist = 0;
    let pinchStartScale = 1;
    let pinchStartTX = 0;
    let pinchStartTY = 0;
    let pinchStartCX = 0;
    let pinchStartCY = 0;

    canvas.addEventListener(
      "touchstart",
      e => {
        if (e.touches.length === 2) {
          e.preventDefault();
          pinchStartDist = Math.hypot(
            e.touches[1].clientX - e.touches[0].clientX,
            e.touches[1].clientY - e.touches[0].clientY
          );
          pinchStartScale = scale;
          pinchStartTX = translateX;
          pinchStartTY = translateY;
          const rect = canvas.getBoundingClientRect();
          pinchStartCX =
            (e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left;
          pinchStartCY =
            (e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top;
        } else if (e.touches.length === 1) {
          pinchStartTX = translateX;
          pinchStartTY = translateY;
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
        }
      },
      { passive: false }
    );

    canvas.addEventListener(
      "touchmove",
      e => {
        if (e.touches.length === 2) {
          e.preventDefault();
          const dist = Math.hypot(
            e.touches[1].clientX - e.touches[0].clientX,
            e.touches[1].clientY - e.touches[0].clientY
          );
          const prev = scale;
          scale = Math.min(
            10,
            Math.max(0.1, pinchStartScale * (dist / pinchStartDist))
          );
          const rect = canvas.getBoundingClientRect();
          const cx =
            (e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left;
          const cy =
            (e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top;
          translateX = cx - (pinchStartCX - pinchStartTX) * (scale / prev);
          translateY = cy - (pinchStartCY - pinchStartTY) * (scale / prev);
          applyTransform();
          updateLabel();
        } else if (e.touches.length === 1) {
          translateX = pinchStartTX + (e.touches[0].clientX - startX);
          translateY = pinchStartTY + (e.touches[0].clientY - startY);
          applyTransform();
        }
      },
      { passive: false }
    );

    requestAnimationFrame(fitView);
  }

  function createMermaidWrapper(source: string, svg: string) {
    const wrapper = document.createElement("div");
    wrapper.className = "mermaid-wrapper";
    wrapper.dataset.mode = "preview";

    const header = document.createElement("div");
    header.className = "mermaid-header";

    const tabGroup = document.createElement("div");
    tabGroup.className = "mermaid-tab-group";

    const previewTab = document.createElement("button");
    previewTab.className = "mermaid-tab active";
    previewTab.textContent = getI18n("i18n-mermaid-preview");
    previewTab.dataset.tab = "preview";

    const sourceTab = document.createElement("button");
    sourceTab.className = "mermaid-tab";
    sourceTab.textContent = getI18n("i18n-mermaid-source");
    sourceTab.dataset.tab = "source";

    tabGroup.append(previewTab, sourceTab);

    const actions = document.createElement("div");
    actions.className = "mermaid-actions";

    const copyBtn = document.createElement("button");
    copyBtn.type = "button";
    copyBtn.className = "mermaid-action-btn";
    copyBtn.innerHTML = copySvg;
    const copyLabel = getI18n("i18n-mermaid-copy");
    const copiedLabel = getI18n("i18n-mermaid-copied") || copyLabel;
    copyBtn.title = copyLabel;
    copyBtn.setAttribute("aria-label", copyLabel);
    copyBtn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(source);
      copyBtn.innerHTML = checkSvg;
      copyBtn.title = copiedLabel;
      copyBtn.setAttribute("aria-label", copiedLabel);
      setTimeout(() => {
        copyBtn.innerHTML = copySvg;
        copyBtn.title = copyLabel;
        copyBtn.setAttribute("aria-label", copyLabel);
      }, 1200);
    });

    const expandBtn = document.createElement("button");
    expandBtn.type = "button";
    expandBtn.className = "mermaid-action-btn";
    expandBtn.innerHTML = expandSvg;
    expandBtn.title = getI18n("i18n-mermaid-fullscreen");
    expandBtn.setAttribute("aria-label", expandBtn.title);

    const body = document.createElement("div");
    body.className = "mermaid-body";

    const previewEl = document.createElement("div");
    previewEl.className = "mermaid-preview";
    previewEl.dataset.mermaidSource = source;
    previewEl.innerHTML = svg;

    const sourceEl = document.createElement("pre");
    sourceEl.className = "mermaid-source";
    sourceEl.textContent = source;

    expandBtn.addEventListener("click", () => {
      createFullscreen(previewEl.innerHTML);
    });

    actions.append(copyBtn, expandBtn);
    header.append(tabGroup, actions);
    body.append(previewEl, sourceEl);
    wrapper.append(header, body);

    tabGroup.addEventListener("click", e => {
      const tab = (e.target as HTMLElement).closest(".mermaid-tab");
      if (!tab) return;
      const mode = (tab as HTMLElement).dataset.tab;
      wrapper.dataset.mode = mode;
      tabGroup
        .querySelectorAll(".mermaid-tab")
        .forEach(t => t.classList.remove("active"));
      tab.classList.add("active");
    });

    return wrapper;
  }

  async function renderMermaid() {
    clearTimeout(Number(document.documentElement.dataset.mermaidWatchdog));
    mermaidSources.length = 0;
    const mermaidBlocks = document.querySelectorAll(
      'pre[data-language="mermaid"]'
    );
    if (mermaidBlocks.length === 0) {
      document.dispatchEvent(new Event("article:layout-stable"));
      return;
    }

    const m = await loadMermaid();
    initMermaidConfig(m);

    for (const pre of mermaidBlocks) {
      const code = pre.querySelector("code");
      const source = stripTheme(code?.textContent || "");
      const el = pre as HTMLElement;
      const block = el.closest<HTMLElement>(".mermaid-block");

      mermaidSources.push({ el, source });

      const id = "mermaid-" + Math.random().toString(36).slice(2);
      try {
        const { svg } = await m.render(id, source);
        const wrapper = createMermaidWrapper(source, svg);
        const key = (block as HTMLElement | null)?.dataset.mermaidKey;
        if (key) wrapper.dataset.mermaidKey = key;
        (block ?? el).replaceWith(wrapper);
        if (key) {
          writeCachedHeight(key, wrapper.offsetHeight, wrapper.offsetWidth);
        }
      } catch {
        if (block) {
          block.setAttribute("aria-busy", "false");
          block.setAttribute("data-state", "error");
          block.style.minHeight = "0px";
          el.style.display = "";
        } else {
          el.setAttribute("style", "color: red");
        }
      } finally {
        document.getElementById("d" + id)?.remove();
      }
    }

    clearTimeout(Number(document.documentElement.dataset.mermaidWatchdog));
    document.dispatchEvent(new Event("article:layout-stable"));
  }

  async function rerenderMermaid() {
    const containers = document.querySelectorAll(
      ".mermaid-preview[data-mermaid-source]"
    );
    if (containers.length === 0) return;

    const m = await loadMermaid();
    initMermaidConfig(m);

    for (const container of containers) {
      const source = (container as HTMLElement).dataset.mermaidSource || "";
      const id = "mermaid-" + Math.random().toString(36).slice(2);
      try {
        const { svg } = await m.render(id, source);
        container.innerHTML = svg;
        const wrapper = container.closest<HTMLElement>(".mermaid-wrapper");
        const key = wrapper?.dataset.mermaidKey;
        if (wrapper && key) {
          writeCachedHeight(key, wrapper.offsetHeight, wrapper.offsetWidth);
        }
      } catch {
        // keep existing svg on errors
      } finally {
        document.getElementById("d" + id)?.remove();
      }
    }
  }

  renderMermaid();
  document.addEventListener("astro:after-swap", renderMermaid);

  new MutationObserver(() => {
    rerenderMermaid();
  }).observe(document.documentElement, {
    attributeFilter: ["data-theme"],
  });
</script>

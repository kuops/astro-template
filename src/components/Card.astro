---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/types/config";
import { getPath } from "@/utils/getPath";
import { getContentLocale } from "@/utils/localizedContent";
import { toTransitionName } from "@/utils/toTransitionName";
import {
  getLocaleFromPath,
  getLocalizedPath,
  tplStr,
  useTranslations,
} from "@/i18n";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  requestedLocale?: Locale;
} & CollectionEntry<"blog">;

const {
  variant: Heading = "h2",
  requestedLocale = getLocaleFromPath(Astro.url.pathname),
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, ...props } = data;
const sourceLocale = getContentLocale({ filePath }, "blog");
const isFallback = sourceLocale !== requestedLocale;
const t = useTranslations(requestedLocale);
const sourceLabel = tplStr(t.language.sourceLabel, {
  language: t.language.names[sourceLocale],
});
---

<li class="my-6">
  <a
    href={getLocalizedPath(getPath(id, filePath), requestedLocale)}
    class="card-title inline-block text-lg font-medium text-accent"
  >
    <Heading style={{ viewTransitionName: toTransitionName(id) }}>
      <span class="card-title-line">{title}</span>
      {isFallback && (
        <span class="ms-2 align-middle text-xs font-normal text-muted-foreground">
          ({sourceLabel})
        </span>
      )}
    </Heading>
  </a>
  <Datetime {...props} />
  <p class="line-clamp-2 font-reading md:line-clamp-none">{description}</p>
</li>

<style>
  /*
   * 标题下的一条实线：平时宽度为 0，悬停或键盘聚焦时从左往右画出来，移开后原路缩回。
   * 用背景而不是 text-decoration，因为 text-decoration 的长度做不了动画。
   * 标题折成多行时，clone 让每一行各有一条线，而不是只在最后一行下面画一条。
   * 线顶大约在基线下方 4px，和原来的下划线位置一致。行内元素的背景只能画在自己的盒子里，
   * 所以用下内边距多留出 2px 给线（不影响行高），再让线从文字盒子的底边画起。
   */
  .card-title-line {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-bottom: 2px;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 calc(100% - 2px);
    background-size: 0% 1.5px;
    transition: background-size 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  /* 和原来的 hover:underline 一样，只在支持悬停的设备上响应鼠标 */
  @media (hover: hover) {
    .card-title:hover .card-title-line {
      background-size: 100% 1.5px;
    }
  }
  .card-title:focus-visible .card-title-line {
    background-size: 100% 1.5px;
  }
  @media (prefers-reduced-motion: reduce) {
    .card-title-line {
      transition: none;
    }
  }
</style>

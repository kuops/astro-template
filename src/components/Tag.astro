---
import { getLocaleFromPath, getLocalizedPath } from "@/i18n";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
---

<li>
  <a
    href={getLocalizedPath(`/tags/${tag}/`, locale)}
    transition:name={tag}
    class:list={[
      // 胶囊标签：强调色淡底 + 正文色；悬停/键盘聚焦时反色为实色强调底
      "inline-flex items-center rounded-full bg-accent/10 text-foreground transition-colors",
      "hover:bg-accent hover:text-accent-foreground",
      "focus-visible:bg-accent focus-visible:text-accent-foreground",
      { "px-2.5 py-1 text-sm": size === "sm" },
      { "px-3.5 py-1.5 text-lg": size === "lg" },
    ]}
  >
    {tagName}
  </a>
</li>

---
import { getLocaleFromPath, useTranslations } from "@/i18n";

const t = useTranslations(getLocaleFromPath(Astro.url.pathname));
---

<span
  class="hidden"
  id="i18n-copy"
  data-copy={t.post.copyCode}
  data-copied={t.post.copied}
  data-heading-anchor={t.a11y.headingAnchor}
></span>

<script is:inline data-astro-rerun>
  window.__articleEnhancementsCleanup?.();
  window.__articleEnhancementsController = new AbortController();

  function createProgressBar() {
    document.getElementById("myBar")?.parentElement?.remove();

    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-50 h-1 w-full bg-background";

    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  function updateScrollProgress() {
    function setProgress() {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      const myBar = document.getElementById("myBar");
      if (myBar) {
        myBar.style.width = scrolled + "%";
      }
    }

    document.addEventListener("scroll", setProgress, {
      passive: true,
      signal: window.__articleEnhancementsController.signal,
    });
    setProgress();
  }
  updateScrollProgress();

  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll(
        "#article h2[id]:not(.sr-only), #article h3[id]:not(.sr-only), #article h4[id]:not(.sr-only)"
      )
    );
    const labelTemplate =
      document.getElementById("i18n-copy")?.dataset.headingAnchor ||
      "Link to section: {{title}}";
    for (const heading of headings) {
      if (heading.querySelector(":scope > .heading-link")) continue;
      const headingText = heading.textContent?.trim() || "";
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-0 transition-opacity focus:opacity-100 active:opacity-100 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;
      link.setAttribute(
        "aria-label",
        labelTemplate.replace("{{title}}", headingText)
      );

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  function fadeInArticleImages() {
    const images = document.querySelectorAll("#article img.img-fade");
    for (const img of images) {
      if (img.complete) {
        img.classList.add("is-loaded");
        continue;
      }
      const reveal = () => img.classList.add("is-loaded");
      img.addEventListener("load", reveal, { once: true });
      img.addEventListener("error", reveal, { once: true });
    }
  }
  fadeInArticleImages();

  function restoreArticleDetails() {
    const details = Array.from(document.querySelectorAll("#article details"));
    if (!details.length) return;

    const storageKey = "article-details:" + window.location.pathname;
    let saved = {};
    try {
      saved = JSON.parse(localStorage.getItem(storageKey) || "{}");
    } catch {}

    const stateKeys = details.map(function (detail, index) {
      const summary = detail
        .querySelector(":scope > summary")
        ?.textContent?.trim();
      return `${index}:${summary || "details"}`;
    });

    details.forEach(function (detail, index) {
      const stateKey = stateKeys[index];
      if (stateKey in saved) detail.open = Boolean(saved[stateKey]);
    });

    function saveState() {
      const state = {};
      details.forEach(function (detail, index) {
        state[stateKeys[index]] = detail.open;
      });
      try {
        localStorage.setItem(storageKey, JSON.stringify(state));
      } catch {}
    }

    details.forEach(function (detail) {
      detail.addEventListener("toggle", saveState, {
        signal: window.__articleEnhancementsController.signal,
      });
    });
  }
  restoreArticleDetails();

  function attachCopyButtons() {
    const i18nEl = document.getElementById("i18n-copy");
    const copyButtonLabel = i18nEl?.dataset.copy || "Copy";
    const copiedLabel = i18nEl?.dataset.copied || "Copied";
    // 剪贴板/对勾图标（内嵌式，文档站同款：卡片内右侧垂直居中）
    const CLIPBOARD_ICON =
      '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>';
    const CHECK_ICON =
      '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
    const codeBlocks = Array.from(document.querySelectorAll("pre")).filter(
      pre =>
        pre.getAttribute("data-language") !== "mermaid" &&
        !pre.closest(".mermaid-block")
    );

    for (const codeBlock of codeBlocks) {
      let wrapper = codeBlock.parentElement;
      if (
        !wrapper ||
        wrapper.tagName !== "DIV" ||
        wrapper.classList.contains("code-tabs-panel")
      ) {
        wrapper = document.createElement("div");
        wrapper.style.position = "relative";
        codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
        wrapper.appendChild(codeBlock);
      }

      const copyButton = document.createElement("button");
      copyButton.type = "button";
      copyButton.className = "code-copy-button";
      copyButton.title = copyButtonLabel;
      copyButton.setAttribute("aria-label", copyButtonLabel);
      copyButton.innerHTML = CLIPBOARD_ICON;
      codeBlock.setAttribute("tabindex", "0");
      wrapper.appendChild(copyButton);

      copyButton.addEventListener("click", async () => {
        const code = codeBlock.querySelector("code");
        const text = code?.innerText;

        await navigator.clipboard.writeText(text ?? "");

        copyButton.innerHTML = CHECK_ICON;
        copyButton.title = copiedLabel;
        copyButton.setAttribute("aria-label", copiedLabel);
        setTimeout(() => {
          copyButton.innerHTML = CLIPBOARD_ICON;
          copyButton.title = copyButtonLabel;
          copyButton.setAttribute("aria-label", copyButtonLabel);
        }, 1200);
      });
    }
  }
  attachCopyButtons();

  function initCodeTabs() {
    const { signal } = window.__articleEnhancementsController;
    const panelActivators = new Map();
    for (const group of document.querySelectorAll("#article .code-tabs")) {
      const bar = group.querySelector(":scope > .code-tabs-bar");
      if (!bar) continue;
      const tabs = Array.from(bar.querySelectorAll(":scope > .code-tabs-tab"));
      const panels = group.querySelectorAll(":scope > .code-tabs-panel");
      if (!tabs.length || tabs.length !== panels.length) continue;

      function activate(index) {
        tabs.forEach(function (tab, i) {
          const selected = i === index;
          tab.classList.toggle("active", selected);
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[i].hidden = !selected;
          // WAI-ARIA tabs 模式：可见的 tabpanel 可聚焦，方便键盘用户进入
          panels[i].tabIndex = selected ? 0 : -1;
        });
        document.dispatchEvent(new Event("article:tabs-change"));
      }

      tabs.forEach(function (tab, index) {
        panelActivators.set(panels[index], () => activate(index));
        tab.addEventListener("click", () => activate(index), { signal });
        tab.addEventListener(
          "keydown",
          function (event) {
            let next;
            if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
            else if (event.key === "ArrowLeft")
              next = (index - 1 + tabs.length) % tabs.length;
            else if (event.key === "Home") next = 0;
            else if (event.key === "End") next = tabs.length - 1;
            else return;
            event.preventDefault();
            activate(next);
            tabs[next].focus();
          },
          { signal }
        );
      });

      activate(
        Math.max(
          0,
          tabs.findIndex(tab => tab.classList.contains("active"))
        )
      );
      bar.hidden = false;
    }

    function revealLinkedPanel() {
      let target;
      try {
        target = document.getElementById(
          decodeURIComponent(location.hash.slice(1))
        );
      } catch {
        return;
      }

      let revealed = false;
      for (
        let panel = target?.closest(".code-tabs-panel");
        panel;
        panel = panel.parentElement?.closest(".code-tabs-panel")
      ) {
        if (!panel.hidden || !panelActivators.has(panel)) continue;
        panelActivators.get(panel)();
        revealed = true;
      }
      if (revealed) target.scrollIntoView();
    }

    if (panelActivators.size) {
      window.addEventListener("hashchange", revealLinkedPanel, { signal });
      revealLinkedPanel();
    }

    // Astro ClientRouter 接管同页锚点点击：preventDefault 后用 pushState
    // 更新地址栏，hashchange 不会触发、浏览器也不滚动。此处对指向本文
    // 存在的锚点的链接统一补齐：展开隐藏面板 + 滚动到位。
    document.addEventListener(
      "click",
      function (event) {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        const link = event.target.closest?.("a[href^='#']");
        if (!link || !link.hash) return;
        let target;
        try {
          target = document.getElementById(
            decodeURIComponent(link.hash.slice(1))
          );
        } catch {
          return;
        }
        if (!target) return;
        const panel = target.closest(".code-tabs-panel");
        if (panel && panel.hidden && panelActivators.has(panel))
          panelActivators.get(panel)();
        target.scrollIntoView();
      },
      { signal }
    );
  }
  initCodeTabs();

  function cleanupArticleEnhancements() {
    window.__articleEnhancementsController?.abort();
  }

  window.__articleEnhancementsCleanup = cleanupArticleEnhancements;
  document.addEventListener("astro:before-swap", cleanupArticleEnhancements, {
    once: true,
    signal: window.__articleEnhancementsController.signal,
  });
</script>

---
import { getLocaleFromPath, useTranslations } from "@/i18n";
import config from "@/config";
// 和风天气官方图标集（代码 MIT / 图标 CC BY 4.0）：字体 + CSS 自托管，运行时同源零外链
import "qweather-icons/font/qweather-icons.css";
import IconLocation from "@/assets/icons/IconLocation.svg";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const ds = {
  locale,
  range: t.home.welcomeRange,
  humidity: t.home.welcomeHumidity,
  wind: t.home.welcomeWind,
  loading: t.home.welcomeLoading,
  fallback: t.home.welcomeFallback,
  observed: t.home.weatherObserved,
};
---

<section
  id="welcome-card"
  class="flex flex-col rounded-lg p-5"
  data-locale={ds.locale}
  data-range={ds.range}
  data-humidity={ds.humidity}
  data-wind={ds.wind}
  data-fallback={ds.fallback}
  data-observed={ds.observed}
  data-proxy={config.weather?.proxy ?? ""}
  aria-live="polite"
>
  <div class="flex items-start justify-between gap-3">
    <p
      id="wc-date"
      class="font-mono text-xs leading-6 text-muted-foreground tabular-nums"
    ></p>
    <p
      id="wc-clock"
      class="font-mono text-sm leading-6 text-accent tabular-nums"
    ></p>
  </div>

  <div class="mt-6 flex flex-1 items-center gap-4">
    <i
      id="wc-icon"
      class="wc-pending text-[3.5rem] leading-none text-accent"
      aria-hidden="true"
    ></i>
    <div class="min-w-0 flex-1">
      <div class="flex items-start gap-0.5">
        <span
          id="wc-temp"
          class="font-mono text-6xl leading-none font-medium text-foreground tabular-nums"
        >
          --
        </span>
        <span class="mt-1.5 text-xl leading-none font-normal text-muted-foreground">
          °
        </span>
      </div>
    </div>
    <div class="flex-none text-end font-mono text-xs leading-5 text-muted-foreground tabular-nums">
      <p id="wc-range"></p>
      <p id="wc-humidity"></p>
      <p id="wc-wind"></p>
    </div>
  </div>
  <p
    id="wc-hello"
    class="wc-pending mt-3 flex items-center gap-1.5 font-reading text-base text-muted-foreground"
  >
    <IconLocation class="size-4 flex-none" aria-hidden="true" />
    <span id="wc-place">{ds.loading}</span>
  </p>

  <div class="flex items-center justify-end gap-2 pt-4 text-xs text-muted-foreground">
    <span id="wc-updated" class="flex-none"></span>
  </div>
</section>

<style>
  /* 语言切换走 ClientRouter 软导航：before-swap 时已用缓存预填新文档，
     这里只是首次访问（无缓存）的兜底——先隐藏，600ms 后仍未就绪才显示 loading */
  #wc-hello.wc-pending {
    opacity: 0;
    animation: wc-pending-show 0s 0.6s forwards;
  }
  @keyframes wc-pending-show {
    to {
      opacity: 1;
    }
  }
  /* 天气图标同理：SSR 无正确码位，禁止兜底出现"太阳"；脚本渲染前不可见 */
  #wc-icon.wc-pending {
    opacity: 0;
  }
</style>

<script>
  type Weather = {
    source?: string;
    city?: string;
    temp?: number | null;
    humidity?: number | null;
    weather?: string;
    weatherEn?: string;
    windDir?: string;
    windDirEn?: string;
    windPower?: string;
    min?: number | null;
    max?: number | null;
    code?: number;
    windDeg?: number | null;
    updateTime?: string;
    // 代理带回的逐日预报（每一天带日期），用来挑出访客今天的温度范围
    forecast?: { ymd: string; low: number | null; high: number | null }[];
  };
  type Cache = { w: Weather; city: string; ts: number };

  // 天气/定位缓存：切语言等站内导航只换文案，不重新拉数据、不闪 loading
  const CACHE_KEY = "welcome-card:cache";
  const CACHE_TTL = 10 * 60 * 1000;
  const readCache = (): Cache | null => {
    try {
      const c = JSON.parse(sessionStorage.getItem(CACHE_KEY) || "null");
      if (c?.w && Date.now() - c.ts < CACHE_TTL) return c;
    } catch {}
    return null;
  };
  const writeCache = (c: Cache) => {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify(c));
    } catch {}
  };

  const QI: Record<string, string> = {
    storm: "302",
    snow: "401",
    rain: "305",
    fog: "501",
    cloud: "104",
    cloudsun: "102",
    sun: "100",
  };
  const iconOf = (w: string): string =>
    /雷/.test(w)
      ? QI.storm
      : /雪/.test(w)
        ? QI.snow
        : /雨/.test(w)
          ? QI.rain
          : /雾|霾/.test(w)
            ? QI.fog
            : /阴/.test(w)
              ? QI.cloud
              : /多云/.test(w)
                ? QI.cloudsun
                : /晴/.test(w)
                  ? QI.sun
                  : "101";

  // WMO 天气代码 → 文案（中/英两套）
  const WMO_TEXT = (c: number, zh: boolean): string =>
    zh
      ? c === 0
        ? "晴"
        : c <= 2
          ? "多云"
          : c === 3
            ? "阴"
            : c <= 48
              ? "雾"
              : c <= 57
                ? "毛毛雨"
                : c <= 67
                  ? "雨"
                  : c <= 77
                    ? "雪"
                    : c <= 82
                      ? "阵雨"
                      : c <= 86
                        ? "阵雪"
                        : "雷阵雨"
      : c === 0
        ? "Clear"
        : c <= 2
          ? "Partly cloudy"
          : c === 3
            ? "Overcast"
            : c <= 48
              ? "Fog"
              : c <= 57
                ? "Drizzle"
                : c <= 67
                  ? "Rain"
                  : c <= 77
                    ? "Snow"
                    : c <= 82
                      ? "Rain showers"
                      : c <= 86
                        ? "Snow showers"
                        : "Thunderstorm";
  // 风向角度 → 方位（中文带"风"，英文用缩写）
  const WIND_DIR = (deg: number, zh: boolean): string =>
    zh
      ? ["北", "东北", "东", "东南", "南", "西南", "西", "西北"][
          Math.round(deg / 45) % 8
        ] + "风"
      : ["N", "NE", "E", "SE", "S", "SW", "W", "NW"][Math.round(deg / 45) % 8];
  // WMO 代码 → 和风天气图标码（语言无关，code 存在时优先于中文文本正则）
  const codeToIcon = (c: number): string =>
    c === 0
      ? "100"
      : c <= 2
        ? "102"
        : c === 3
          ? "104"
          : c <= 48
            ? "501"
            : c <= 67
              ? "305"
              : c <= 77
                ? "401"
                : c <= 82
                  ? "306"
                  : c <= 86
                    ? "407"
                    : "302";

  const getJSON = async (url: string, ms = 6000) => {
    const ctl = new AbortController();
    const to = window.setTimeout(() => ctl.abort(), ms);
    try {
      const r = await fetch(url, { signal: ctl.signal });
      if (!r.ok) throw new Error(String(r.status));
      return await r.json();
    } finally {
      window.clearTimeout(to);
    }
  };

  // ── 定位：按访客 IP 拿城市和坐标 ──────────────────────────────────
  type Loc = {
    lat: number;
    lon: number;
    // 给访客看的地名，按站点语言：中文页拿中文名（没有中文名时是英文），英文页是英文
    name: string;
    // ISO 两位国家/地区代码，大写
    country: string;
  };
  const isNum = (v: unknown): v is number =>
    typeof v === "number" && Number.isFinite(v);
  const firstText = (...vals: unknown[]) =>
    vals
      .find((v): v is string => typeof v === "string" && v.trim() !== "")
      ?.trim() ?? "";
  // 请求带上时间戳，防止中间缓存把别人的定位结果发回来
  const noCache = () => "_=" + Date.now();

  // 主：ipwho.is。免 key、支持跨域，境外 IP 也能定位，而且带经纬度——大陆城市的
  // 坐标实测准确，落在它说的城市里。中文名只有 lang=zh-CN 才有，台湾和海外的城市名是繁体
  const locateByIpWho = async (zh: boolean): Promise<Loc | null> => {
    const j = await getJSON(
      "https://ipwho.is/?" + (zh ? "lang=zh-CN&" : "") + noCache(),
      5000
    );
    if (j?.success === false || !isNum(j?.latitude) || !isNum(j?.longitude))
      return null;
    const name = firstText(j.city, j.region, j.country);
    if (!name) return null;
    return {
      lat: j.latitude,
      lon: j.longitude,
      name,
      country: String(j.country_code ?? "").toUpperCase(),
    };
  };

  // 备：ip.sb。它的坐标在中国大陆不可用（大陆 IP 多数返回同一个点，和城市对不上），
  // 所以只取城市名，坐标按名字向 Open-Meteo 地理编码另查。按名字也查不到、又是在
  // 大陆，就宁可不算定位成功，免得拿着错的坐标取来别处的天气
  const locateByIpSb = async (zh: boolean): Promise<Loc | null> => {
    const j = await getJSON("https://api.ip.sb/geoip?" + noCache(), 5000);
    const name = firstText(j?.city, j?.region);
    const country = String(j?.country_code ?? "").toUpperCase();
    if (!name) return null;
    const g = await getJSON(
      "https://geocoding-api.open-meteo.com/v1/search?name=" +
        encodeURIComponent(name) +
        "&count=1&language=" +
        (zh ? "zh" : "en") +
        (country ? "&countrycode=" + country : "") +
        "&format=json"
    );
    const hit = g?.results?.[0];
    if (hit && isNum(hit.latitude) && isNum(hit.longitude))
      return {
        lat: hit.latitude,
        lon: hit.longitude,
        name: zh ? firstText(hit.name) || name : name,
        country,
      };
    return country &&
      country !== "CN" &&
      isNum(j?.latitude) &&
      isNum(j?.longitude)
      ? { lat: j.latitude, lon: j.longitude, name, country }
      : null;
  };

  // 主接口不可用（超时、报错）时换备用的
  const locate = async (zh: boolean): Promise<Loc | null> => {
    for (const attempt of [locateByIpWho, locateByIpSb]) {
      try {
        const loc = await attempt(zh);
        if (loc) return loc;
      } catch {}
    }
    return null;
  };

  // 坐标 → 中国天气网的站点（JSONP：接口不支持跨域，但免 key、无防盗链）。返回站号、
  // 站名和它所属的地级市：天气代理按站号查最精确，海外的站点也只有站号靠得住（韩国的
  // 大田和福建的大田就重名）。台北、香港、新加坡、纽约这些坐标都有站点，连大洋中间也有
  // （给的是最近的站）；大陆给到区县一级，比如慈溪
  const cnStation = (
    lat: number,
    lon: number,
    timeoutMs = 5000
  ): Promise<{
    code: string;
    name: string;
    city: string;
    taiwan: boolean;
  } | null> =>
    new Promise(resolve => {
      const cb = "__wStation" + Math.random().toString(36).slice(2, 10);
      const holder = window as unknown as Record<
        string,
        | ((data: {
            status?: string;
            data?: { station?: Record<string, unknown> };
          }) => void)
        | undefined
      >;
      const s = document.createElement("script");
      let settled = false;
      const finish = (
        v: {
          code: string;
          name: string;
          city: string;
          taiwan: boolean;
        } | null
      ) => {
        if (settled) return;
        settled = true;
        window.clearTimeout(timer);
        delete holder[cb];
        s.remove();
        resolve(v);
      };
      const timer = window.setTimeout(() => finish(null), timeoutMs);
      holder[cb] = data => {
        const st = data?.data?.station;
        if (data?.status !== "success" || !st) return finish(null);
        const text = (k: string) =>
          typeof st[k] === "string" ? st[k].trim() : "";
        const name = text("namecn");
        if (!name) return finish(null);
        // 站号有时给字符串、有时给数字，所以不用 text() 取；不是 9 位数字就不带
        const code = String(st.areaid ?? "").trim();
        finish({
          code: /^\d{9}$/.test(code) ? code : "",
          name,
          // 这个接口把表示「地级市」的字段写成了 distictcn（个别站是 districtcn），两种都认
          city: text("distictcn") || text("districtcn"),
          taiwan: /台湾|臺灣|taiwan/i.test(
            text("provincecn") + text("provinceen")
          ),
        });
      };
      s.onerror = () => finish(null);
      s.src =
        "https://d4.weather.com.cn/geong/v1/api?params=" +
        encodeURIComponent(
          JSON.stringify({ method: "stationinfo", lat, lng: lon, callback: cb })
        );
      document.head.appendChild(s);
    });

  // 按坐标向 Open-Meteo 要天气。接口免 key、CORS 开放；weather 用 WMO code、
  // 风向用角度存语言无关值，渲染时按 locale 转文案
  const fetchWeatherByCoords = async (loc: Loc): Promise<Weather | null> => {
    try {
      const j = await getJSON(
        "https://api.open-meteo.com/v1/forecast?latitude=" +
          loc.lat +
          "&longitude=" +
          loc.lon +
          "&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,wind_direction_10m&daily=temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=1"
      );
      const cur = j?.current;
      if (!cur) return null;
      return {
        source: "open-meteo",
        city: loc.name,
        temp: Math.round(cur.temperature_2m),
        humidity: Math.round(cur.relative_humidity_2m),
        code: cur.weather_code,
        windDeg: cur.wind_direction_10m ?? null,
        windPower: Math.round(cur.wind_speed_10m) + " km/h",
        min:
          j?.daily?.temperature_2m_min?.[0] != null
            ? Math.round(j.daily.temperature_2m_min[0])
            : null,
        max:
          j?.daily?.temperature_2m_max?.[0] != null
            ? Math.round(j.daily.temperature_2m_max[0])
            : null,
      };
    } catch {
      return null;
    }
  };

  // 官方代理（Cloudflare Worker，见 workers/weather-proxy.js）：Worker 以合法
  // Referer 抓中国天气网，返回归一化后的数据（含 weatherEn/windDirEn）。
  // 有站号就按站号查（code），没有就按城市名或区县名查。没配或查不到时回退 Open-Meteo
  let PROXY = "";
  const fetchProxyWeather = async (
    code: string,
    city: string
  ): Promise<Weather | null> => {
    if (!PROXY) return null;
    try {
      const j = await getJSON(
        PROXY +
          "/weather?" +
          (code ? "code=" + code + "&" : "") +
          "city=" +
          encodeURIComponent(city)
      );
      return j && j.source === "weather.com.cn" ? j : null;
    } catch {
      return null;
    }
  };

  // 国际站点的预报每天只更新一次，列表的第一天是「更新那一刻在当地的那一天」，对欧洲和
  // 美洲来说几乎全天都是昨天。代理会带回整份预报和每一天的日期，这里按访客自己日历上的
  // 今天挑出温度范围；列表里没有这一天（访客的时区和站点差得远）就用代理给的值
  const pickToday = (w: Weather): Weather => {
    const days = w.forecast;
    if (!days?.length) return w;
    const now = new Date();
    const today = now.getMonth() + 1 + "-" + now.getDate();
    const hit = days.find(
      f => String(f.ymd || "").replace(/^\d+-/, "") === today
    );
    return hit ? { ...w, min: hit.low ?? w.min, max: hit.high ?? w.max } : w;
  };

  // 访客本地天气。定位已经拿到坐标，不再把城市名换成坐标（按名字查会认错地方）：
  //   ① 坐标换成中国天气网的站点 → 天气代理（中国气象局的数据，海外城市也有）
  //   ② 没有站点、代理没配或查不到 → 按坐标向 Open-Meteo 要
  // 返回的 city 是给访客看的地名：走代理时是站名（中文页）或定位接口给的名字（英文页，
  // 中国天气网的英文名是拼音），否则是定位接口给的名字
  const fetchWeather = async (
    loc: Loc,
    zh: boolean
  ): Promise<{ w: Weather | null; city: string }> => {
    try {
      const st = await cnStation(loc.lat, loc.lon);
      // 台湾的 IP 只认台湾的站点：中国天气网没有澎湖、马祖，它们的坐标会落到福建的站点上，
      // 那是别处的天气。金门例外，它有自己的站点，归在福建泉州下面
      if (st && (loc.country !== "TW" || st.taiwan || st.name === "金门")) {
        const done = (w: Weather, key: string) => ({
          w: pickToday(w),
          city: zh ? key : loc.name,
        });
        // 先按站号查。代理还是不认站号的旧版本时，它只会拿站名去查
        const byCode = await fetchProxyWeather(st.code, st.name);
        if (byCode) return done(byCode, st.name);
        // 站号没查到（这个站上游暂时没数据、或旧版代理里没有这个站名）：退一步按地级市名查
        if (st.city && st.city !== st.name) {
          const byCity = await fetchProxyWeather("", st.city);
          if (byCity) return done(byCity, st.city);
        }
      }
      return { w: await fetchWeatherByCoords(loc), city: loc.name };
    } catch {
      return { w: null, city: loc.name };
    }
  };

  // 渲染函数作用于"文档根"：既可以是当前 document，也可以是 ClientRouter 即将换入的 newDocument
  const renderInto = (
    root: Document,
    card: HTMLElement,
    w: Weather | null,
    city: string | null
  ) => {
    const d = card.dataset;
    const zh = (d.locale || "zh").startsWith("zh");
    const $ = (id: string) => root.getElementById(id);
    const tpl = (s: string, v: Record<string, string | number>) =>
      s.replace(/\{\{(\w+)\}\}/g, (_, k) => String(v[k] ?? ""));
    const now = new Date();
    const clock = $("wc-clock");
    const date = $("wc-date");
    if (clock)
      clock.textContent = now.toLocaleTimeString(zh ? "zh-CN" : "en-GB", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      });
    if (date)
      date.textContent = now.toLocaleDateString(zh ? "zh-CN" : "en-US", {
        month: "long",
        day: "numeric",
        weekday: "long",
      });
    // 天气现象文案（code 存在按当前语言渲染；否则 Worker 给的原文本，英文优先 weatherEn）
    const condText = w
      ? w.code != null
        ? WMO_TEXT(w.code, zh)
        : zh
          ? (w.weather ?? "")
          : ((w.weatherEn || w.weather) ?? "")
      : "";
    if (city !== null) {
      const hello = $("wc-hello");
      if (hello) hello.classList.remove("wc-pending");
      const place = $("wc-place");
      if (place)
        place.textContent =
          w && condText ? `${city}${zh ? "，" : ", "}${condText}` : city;
    }
    if (!w) return;
    const icon = $("wc-icon");
    if (icon) {
      icon.className =
        "qi-" +
        (w.code != null ? codeToIcon(w.code) : iconOf(w.weather || "")) +
        " text-accent";
      icon.style.fontSize = "3.5rem";
    }
    const temp = $("wc-temp");
    if (temp) temp.textContent = String(w.temp ?? "--");
    const range = $("wc-range");
    if (range && w.min != null)
      range.textContent = tpl(d.range || "", {
        min: w.min + "°",
        max: w.max + "°",
      });
    const hum = $("wc-humidity");
    if (hum && w.humidity != null)
      hum.textContent = `${d.humidity ?? ""} ${w.humidity}%`;
    const wind = $("wc-wind");
    if (wind)
      wind.textContent =
        w.windDeg != null
          ? `${WIND_DIR(w.windDeg, zh)}${zh ? "" : " "}${w.windPower ?? ""}`.trim()
          : zh
            ? `${w.windDir ?? ""}${w.windPower ?? ""}`.trim()
            : `${(w.windDirEn || w.windDir) ?? ""} ${String(w.windPower ?? "").replace(/(\d+(?:-\d+)?)级/, "$1 Bft")}`.trim();
    // 实况观测时间（气象站发布时刻）：Worker 给 "HH:mm"；Open-Meteo 给 ISO 时间取其时分
    const upd = $("wc-updated");
    if (upd) {
      const raw = String(w.updateTime ?? "");
      const hhmm = raw.includes("T") ? raw.slice(11, 16) : raw;
      upd.textContent = hhmm
        ? tpl(d.observed || "{{time}}", { time: hhmm })
        : "";
    }
  };

  let cleanup: (() => void) | null = null;
  const initWelcome = () => {
    const card = document.getElementById("welcome-card");
    if (!card) {
      cleanup?.();
      cleanup = null;
      return;
    }
    // 同一张卡已初始化（模块执行与 astro:page-load 各触发一次）：直接返回
    if (card.dataset.init === "1") return;
    cleanup?.();
    cleanup = null;
    card.dataset.init = "1";
    PROXY = (card.dataset.proxy || "").replace(/\/+$/, "");
    const zh = (card.dataset.locale || "zh").startsWith("zh");
    // 时钟
    const timer = window.setInterval(
      () => renderInto(document, card, null, null),
      1000
    );

    const cached = readCache();
    if (cached) renderInto(document, card, cached.w, cached.city);
    else {
      let alive = true;
      (async () => {
        // 1) 先定位访客（按 IP，境外 IP 也能定位）
        const loc = await locate(zh);
        if (!alive) return;

        // 2) 定位失败：只显示一句提示，不缓存，下次访问再试
        if (!loc) {
          renderInto(document, card, null, card.dataset.fallback ?? "");
          return;
        }

        // 3) 定位成功：按坐标取访客本地天气（天气代理优先，Open-Meteo 兜底）
        const { w, city } = await fetchWeather(loc, zh);
        if (!alive) return;
        if (w) {
          renderInto(document, card, w, city);
          writeCache({ w, city, ts: Date.now() });
          return;
        }
        // 拿不到天气数据：只把访客城市和一句提示写进问候行（renderInto 的天气参数为
        // null）。不缓存，下次访问再试
        renderInto(
          document,
          card,
          null,
          `${loc.name}${zh ? "，" : " — "}${card.dataset.fallback ?? ""}`
        );
      })();
      cleanup = () => {
        alive = false;
        window.clearInterval(timer);
      };
      return;
    }
    cleanup = () => {
      window.clearInterval(timer);
    };
  };

  initWelcome();
  document.addEventListener("astro:page-load", initWelcome);
  // 换页前：清理旧页定时器，并把缓存数据直接写进即将换入的新文档，页面出现时即为最终内容（零 loading 闪烁）
  document.addEventListener("astro:before-swap", e => {
    cleanup?.();
    cleanup = null;
    const cached = readCache();
    if (!cached) return;
    const doc = e.newDocument;
    const newCard = doc.getElementById("welcome-card");
    if (newCard) renderInto(doc, newCard, cached.w, cached.city);
  });
</script>

---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconLanguage from "@/assets/icons/IconLanguage.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconBarsMenu from "@/assets/icons/IconBarsMenu.svg";
import config from "@/config";
import {
  getAlternateLocale,
  getLocaleFromPath,
  getLocalizedPath,
  stripLocalePrefix,
  useTranslations,
} from "@/i18n";

type Props = {
  maxWidth?: string;
  alternateUrl?: string;
};

const { maxWidth, alternateUrl } = Astro.props;

const { pathname } = Astro.url;
const locale = getLocaleFromPath(pathname);
const t = useTranslations(locale);
const alternateLocale = getAlternateLocale(locale);
const targetLanguage = alternateLocale
  ? t.language.names[alternateLocale]
  : undefined;
const localizedPath = (path: string) => getLocalizedPath(path, locale);

// Remove trailing slash from current pathname if exists
const unprefixedPath = stripLocalePrefix(pathname).pathname;
const currentPath =
  unprefixedPath.endsWith("/") && unprefixedPath !== "/"
    ? unprefixedPath.slice(0, -1)
    : unprefixedPath;
const fallbackAlternatePath = currentPath.startsWith("/posts/")
  ? "/posts"
  : currentPath.startsWith("/books/")
    ? "/books"
    : currentPath === "/about"
      ? "/"
      : currentPath;
const languageHref = alternateLocale
  ? (alternateUrl ?? getLocalizedPath(fallbackAlternatePath, alternateLocale))
  : undefined;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const isCurrentPage = (path: string) => currentPath === path;
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class:list={[
    maxWidth ?? "mx-auto w-full max-w-chrome px-4",
    "flex flex-col items-center justify-between md:flex-row",
  ]}
>
  <div
    id="top-nav-wrap"
    class:list={[
      "py-4 md:py-6",
      "border-b border-border",
      "relative w-full bg-background",
      "flex items-baseline justify-between md:items-center",
    ]}
  >
    <a
      href={localizedPath("/")}
      class="absolute z-10 py-1 text-xl leading-8 font-semibold whitespace-nowrap md:static md:my-auto md:text-2xl md:leading-none"
    >
      {config.site.title}
    </a>
    <nav
      id="nav-menu"
      class="relative flex w-full flex-col items-center md:ms-2 md:flex-row md:justify-end md:space-x-4 md:py-0"
    >
      <div class="flex w-full items-center justify-end gap-1 md:contents">
        <button
          id="search-btn-mobile"
          class="focus-outline flex size-12 items-center justify-center hover:text-accent md:hidden"
          title={`${t.nav.search} (Ctrl+K)`}
          aria-label={t.nav.search}
        >
          <IconSearch />
          <span class="sr-only">{t.nav.search}</span>
        </button>
        <button
          id="menu-btn"
          class="focus-outline flex size-12 items-center justify-center self-end md:hidden"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="menu-items"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <IconX id="close-icon" class="hidden" />
          <IconBarsMenu id="menu-icon" />
        </button>
      </div>
      <ul
        id="menu-items"
        class:list={[
          "absolute top-full right-0 z-50 grid min-w-44 grid-cols-[1fr_auto_auto] gap-1 rounded-[var(--surface-radius)] border border-border bg-background px-4 py-2 shadow-lg dark:border-foreground/15 dark:shadow-none",
          "[&>li>a]:flex [&>li>a]:min-h-12 [&>li>a]:items-center [&>li>a]:px-3 [&>li>a]:font-medium [&>li>a]:hover:text-accent md:[&>li>a]:min-h-8 md:[&>li>a]:px-2 md:[&>li>a]:py-1",
          "hidden",
          "md:static md:inset-auto md:mt-0 md:flex md:w-auto md:min-w-0 md:items-center md:gap-x-3 md:gap-y-0 md:rounded-none md:border-0 md:p-0 md:shadow-none",
        ]}
      >
        <li class="order-4 col-span-3 md:order-1">
          <a
            href={localizedPath("/books")}
            class:list={{ "active-nav": isActive("/books") }}
            aria-current={isCurrentPage("/books") ? "page" : undefined}
          >
            {t.nav.books}
          </a>
        </li>
        <li class="order-4 col-span-3 md:order-1">
          <a
            href={localizedPath("/posts")}
            class:list={{ "active-nav": isActive("/posts") }}
            aria-current={isCurrentPage("/posts") ? "page" : undefined}
          >
            {t.nav.posts}
          </a>
        </li>
        <li class="order-4 col-span-3 md:order-1">
          <a
            href={localizedPath("/tags")}
            class:list={{ "active-nav": isActive("/tags") }}
            aria-current={isCurrentPage("/tags") ? "page" : undefined}
          >
            {t.nav.tags}
          </a>
        </li>
        <li class="order-4 col-span-3 md:order-1">
          <a
            href={localizedPath("/about")}
            class:list={{ "active-nav": isActive("/about") }}
            aria-current={isCurrentPage("/about") ? "page" : undefined}
          >
            {t.nav.about}
          </a>
        </li>
        {
          config.features.showArchives && (
            <li class="order-4 col-span-3 md:order-1">
              <a
                href={localizedPath("/archives")}
                class:list={{ "active-nav": isActive("/archives") }}
                aria-current={isCurrentPage("/archives") ? "page" : undefined}
              >
                {t.nav.archives}
              </a>
            </li>
          )
        }
        <li
          aria-hidden="true"
          class="order-3 col-span-3 my-1 border-t border-border md:order-2 md:my-0 md:h-5 md:w-px md:border-s md:border-t-0"
        >
        </li>
        {
          alternateLocale && languageHref && targetLanguage && (
            <li class="order-1 flex items-center justify-self-end md:order-3">
              <a
                href={languageHref}
                class="focus-outline flex min-w-12 justify-center !p-3 md:min-w-0 md:!p-1"
                title={`${t.language.switchLanguage}: ${targetLanguage}`}
                aria-label={`${t.language.switchLanguage}: ${targetLanguage}`}
                lang={alternateLocale}
                hreflang={alternateLocale}
              >
                <IconLanguage />
              </a>
            </li>
          )
        }
        <li class="hidden items-center md:order-4 md:flex">
          <button
            id="search-btn"
            class="focus-outline flex p-3 hover:text-accent md:p-1"
            title={`${t.nav.search} (Ctrl+K)`}
            aria-label={t.nav.search}
          >
            <IconSearch />
            <span class="sr-only">{t.nav.search}</span>
          </button>
        </li>
        {
          config.features.lightAndDarkMode && (
            <li class="order-2 flex items-center md:order-5">
              <button
                id="theme-btn"
                class="focus-outline relative size-12 p-4 hover:text-accent md:size-8"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="icon-moon absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 dark:scale-0 dark:-rotate-90 [.theme-ready_&]:motion-safe:transition-transform [.theme-ready_&]:motion-safe:duration-300" />
                <IconSunHigh class="icon-sun absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 dark:scale-100 dark:rotate-0 [.theme-ready_&]:motion-safe:transition-transform [.theme-ready_&]:motion-safe:duration-300" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  let navController: AbortController | undefined;

  function toggleNav() {
    navController?.abort();
    navController = new AbortController();

    const menuBtn = document.querySelector("#menu-btn") as HTMLElement | null;
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    const navMenu = document.querySelector("#nav-menu");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon || !navMenu) return;

    const setOpen = (open: boolean, restoreFocus = false) => {
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute(
        "aria-label",
        open
          ? (menuBtn.dataset.labelClose ?? "Close Menu")
          : (menuBtn.dataset.labelOpen ?? "Open Menu")
      );
      menuItems.classList.toggle("hidden", !open);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      if (restoreFocus) menuBtn.focus();
    };

    menuBtn.addEventListener(
      "click",
      () => setOpen(menuBtn.getAttribute("aria-expanded") !== "true"),
      { signal: navController.signal }
    );
    menuItems.addEventListener(
      "click",
      event => {
        if (
          event.target instanceof Element &&
          event.target.closest("a, #search-btn")
        ) {
          setOpen(false);
        }
      },
      { signal: navController.signal }
    );
    document.addEventListener(
      "click",
      event => {
        if (
          menuBtn.getAttribute("aria-expanded") === "true" &&
          event.target instanceof Node &&
          !navMenu.contains(event.target)
        ) {
          setOpen(false);
        }
      },
      { signal: navController.signal }
    );
    document.addEventListener(
      "keydown",
      event => {
        if (
          event.key === "Escape" &&
          menuBtn.getAttribute("aria-expanded") === "true"
        ) {
          setOpen(false, true);
        }
      },
      { signal: navController.signal }
    );
  }

  toggleNav();

  // 无障碍：跳转链接把真实键盘焦点移到主内容区（上游 v7.0 #665）
  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          { once: true }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  function bindSearchBtn() {
    const buttons = document.querySelectorAll(
      "#search-btn, #search-btn-mobile"
    );
    if (!buttons.length) return;
    buttons.forEach(searchBtn => {
      searchBtn.addEventListener(
        "click",
        () => {
          // 移动端顶栏入口：若导航抽屉开着，先收起
          const menuBtn = document.querySelector(
            "#menu-btn"
          ) as HTMLElement | null;
          if (menuBtn?.getAttribute("aria-expanded") === "true") {
            menuBtn.click();
          }
          const modal = document.querySelector(
            "#search-modal"
          ) as HTMLDialogElement | null;
          modal?.showModal();
        },
        { signal: navController?.signal }
      );
    });
  }
  bindSearchBtn();
  handleSkipToContent();

  document.addEventListener("astro:after-swap", toggleNav);
  document.addEventListener("astro:after-swap", bindSearchBtn);
  document.addEventListener("astro:after-swap", handleSkipToContent);
  document.addEventListener("astro:before-swap", () => navController?.abort());
</script>

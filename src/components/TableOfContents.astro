---
import { getLocaleFromPath, useTranslations } from "@/i18n";

const t = useTranslations(getLocaleFromPath(Astro.url.pathname));

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

type Props = {
  headings: Heading[];
};

const { headings } = Astro.props;

const minDepth =
  headings.length > 0 ? Math.min(...headings.map(h => h.depth)) : 2;
---

<nav class="toc hidden xl:block" aria-label="Table of contents">
  <h2
    class="mb-2 text-sm font-semibold tracking-wider text-muted-foreground uppercase"
  >
    {t.pages.toc}
  </h2>
  <ul class="space-y-0.5 text-sm">
    {
      headings.map(({ depth, slug, text }) => {
        const indent = depth - minDepth;
        const isTop = indent === 0;
        return (
          <li class="toc-item">
            <a
              href={`#${slug}`}
              class:list={[
                "toc-link block rounded-md py-1 pr-1 hover:text-accent",
                isTop
                  ? "text-[13.5px] text-foreground/85"
                  : "text-[12.5px] text-muted-foreground",
              ]}
              data-heading-slug={slug}
              title={text}
            >
              <span
                class="toc-label"
                style={`padding-inline-start: ${indent * 0.875}rem`}
              >
                {text}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script is:inline data-astro-rerun>
  function initTocHighlight() {
    const toc = document.querySelector(".toc");
    if (!toc) return;
    toc.__tocCleanup?.();

    const tocLinks = toc.querySelectorAll(".toc-link");
    if (tocLinks.length === 0) return;

    const article = document.getElementById("article");
    if (!article) return;

    const headings = Array.from(
      article.querySelectorAll("h2, h3, h4, h5, h6")
    ).filter(heading => !heading.classList.contains("sr-only"));
    const scroller = toc.closest("[data-toc-scroll]");
    const controller = new AbortController();
    const visibleMedia = window.matchMedia("(min-width: 1280px)");
    let frameId = 0;

    function setActive() {
      const root = document.documentElement;
      const scrollTotal = root.scrollHeight - root.clientHeight;
      const atBottom = scrollTotal > 0 && scrollTotal - root.scrollTop <= 2;
      const visibleHeadings = headings.filter(
        heading => !heading.closest(".code-tabs-panel[hidden]")
      );
      let currentId = visibleHeadings[0]?.id || "";
      if (atBottom) {
        currentId = visibleHeadings.at(-1)?.id || currentId;
      } else {
        for (const heading of visibleHeadings) {
          const rect = heading.getBoundingClientRect();
          if (rect.top <= 120) {
            currentId = heading.id;
          }
        }
      }

      let activeLink = null;
      tocLinks.forEach(link => {
        const slug = link.getAttribute("data-heading-slug");
        const li = link.closest(".toc-item");
        const active = slug === currentId;
        li?.classList.toggle("active", active);
        if (active) {
          link.setAttribute("aria-current", "location");
          activeLink = link;
        } else link.removeAttribute("aria-current");
      });

      if (
        scroller &&
        activeLink &&
        scroller.scrollHeight > scroller.clientHeight
      ) {
        const li = activeLink.closest(".toc-item");
        const top = li.offsetTop;
        const bottom = top + li.offsetHeight;
        const viewTop = scroller.scrollTop;
        const viewBottom = viewTop + scroller.clientHeight;
        // 最小位移跟随（Mintlify 同款语义：只保证激活项可见，不平滑居中）：
        // 无动画的瞬移不会在页面滚动时造成 TOC 容器反复滚动的闪跳
        let target;
        if (top < viewTop + 8) {
          target = Math.max(0, top - 8);
        } else if (bottom > viewBottom - 8) {
          target = bottom - scroller.clientHeight + 8;
        }
        if (target !== undefined) {
          scroller.scrollTo({ top: target, behavior: "instant" });
        }
      }
    }

    function scheduleActive() {
      if (!visibleMedia.matches || frameId) return;
      frameId = window.requestAnimationFrame(function () {
        frameId = 0;
        setActive();
      });
    }

    window.addEventListener("scroll", scheduleActive, {
      passive: true,
      signal: controller.signal,
    });
    document.addEventListener("article:tabs-change", scheduleActive, {
      signal: controller.signal,
    });
    visibleMedia.addEventListener("change", scheduleActive, {
      signal: controller.signal,
    });
    scheduleActive();

    function cleanup() {
      if (frameId) window.cancelAnimationFrame(frameId);
      controller.abort();
    }

    toc.__tocCleanup = cleanup;
    document.addEventListener("astro:before-swap", cleanup, {
      once: true,
      signal: controller.signal,
    });
  }
  initTocHighlight();
</script>

<style>
  /* 全目录统一字重：激活只变颜色。字重跳变会让 CJK 字形宽度变化
     （伪粗体重排），产生肉眼可见的“闪一下”——主流文档站均无此问题 */
  .toc-link {
    font-weight: 500;
    /* 仅 color 过渡：安全（muted→accent 不经过透明）。
       不能用 transition-colors 全量过渡——渐变文字（color:transparent +
       background-clip:text）失活时 background 立即消失而 color 仍处于
       transparent 起点，150ms 内文字近乎不可见，即滚动时的“闪一下” */
    transition: color 0.15s ease;
  }
  .toc-item.active .toc-link {
    background-image: linear-gradient(
      115deg,
      var(--accent),
      color-mix(in srgb, var(--accent) 55%, var(--foreground))
    );
    -webkit-background-clip: text;
    background-clip: text;
    /* 只隐去文字底色（立即生效，不参与过渡）；color 恒为灰色。
       若用 color:transparent，失活时 color 从 transparent 过渡回灰色，
       150ms 内文字近乎不可见——滚动时的“闪一下” */
    -webkit-text-fill-color: transparent;
  }
  .toc-label {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
